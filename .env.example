# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Kafka / Redpanda Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_WIKI_RAW=wiki-raw-articles
KAFKA_TOPIC_WIKI_DLQ=wiki-raw-articles-dlq
KAFKA_CONSUMER_GROUP=wiki-ingestion-group

# Neo4j Database (Graph + Vector)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password123

# Embedding & LLM Provider (Hỗ trợ: ollama, openai, huggingface)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSION=384
OLLAMA_BASE_URL=http://localhost:11434

# Nếu dùng OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Service Ports & Flags
RAG_API_PORT=8000
RAG_DEBUG_TRACE_ENABLED=true

# Security & RBAC JWT Secret (Bắt buộc cấu hình tối thiểu 32 ký tự, không dùng default)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_here

# Observability Scrape Security Header (X-Metrics-Token, bảo vệ /metrics)
METRICS_SCRAPE_TOKEN=your_metrics_scrape_token_for_prometheus_here
